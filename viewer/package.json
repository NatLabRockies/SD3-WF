{
  "name": "viewer",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "scripts": {
    "dev": "vite dev",
    "build": "vite build",
    "preview": "vite preview",
    "prepare": "svelte-kit sync || echo ''",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "format": "prettier --write .",
    "test:unit": "vitest",
    "test": "npm run test:unit -- --run && npm run test:e2e",
    "test:e2e": "playwright test",
    "proto:build": "pbjs -t static-module -w es6 --no-create --no-encode --no-service -o src/lib/generated/sd3.js ../proto/scenario.proto ../proto/feeder.proto && pbts -o src/lib/generated/sd3.d.ts src/lib/generated/sd3.js",
    "proto:watch": "chokidar '../../../proto/**/*.proto' -c 'bun proto:build'",
    "prebuild": "bun proto:build"
  },
  "devDependencies": {
    "@playwright/test": "^1.58.0",
    "@sveltejs/kit": "^2.50.1",
    "@sveltejs/vite-plugin-svelte": "^6.2.4",
    "@tailwindcss/typography": "^0.5.19",
    "@tailwindcss/vite": "^4.1.18",
    "@types/culori": "^4.0.1",
    "@types/node": "^22",
    "@vitest/browser-playwright": "^4.0.18",
    "chokidar-cli": "^3.0.0",
    "globals": "^17.1.0",
    "oxlint": "^1.56.0",
    "playwright": "^1.58.0",
    "prettier": "^3.8.1",
    "prettier-plugin-svelte": "^3.4.1",
    "prettier-plugin-tailwindcss": "^0.7.2",
    "protobufjs-cli": "^2.0.0",
    "svelte": "^5.48.2",
    "svelte-check": "^4.3.5",
    "tailwindcss": "^4.1.18",
    "typescript": "^5.9.3",
    "vite": "^7.3.1",
    "vitest": "^4.0.18",
    "vitest-browser-svelte": "^2.0.2"
  },
  "dependencies": {
    "@sveltejs/adapter-static": "^3.0.10",
    "@types/d3": "^7.4.3",
    "culori": "^4.0.2",
    "d3": "^7.9.0",
    "protobufjs": "^8.0.0"
  }
}
