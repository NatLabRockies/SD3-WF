{
	"name": "viewer",
	"private": true,
	"version": "0.0.1",
	"type": "module",
	"scripts": {
		"dev": "vite dev",
		"build": "vite build",
		"preview": "vite preview",
		"prepare": "svelte-kit sync || echo ''",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"lint": "oxlint",
		"lint:fix": "oxlint --fix",
		"format": "prettier --write .",
		"test:unit": "vitest",
		"test": "npm run test:unit -- --run && npm run test:e2e",
		"test:e2e": "playwright test",
		"proto:build": "pbjs -t static-module -w es6 --no-create --no-encode --no-service -o src/lib/generated/sd3.js ../proto/scenario.proto ../proto/feeder.proto && pbts -o src/lib/generated/sd3.d.ts src/lib/generated/sd3.js",
		"proto:watch": "chokidar '../../../proto/**/*.proto' -c 'npm run proto:build'",
		"prebuild": "npm run proto:build"
	},
	"devDependencies": {
		"@playwright/test": "^1.59.1",
		"@sveltejs/kit": "^2.59.1",
		"@sveltejs/vite-plugin-svelte": "^6.2.4",
		"@tailwindcss/typography": "^0.5.19",
		"@tailwindcss/vite": "^4.2.4",
		"@types/culori": "^4.0.1",
		"@types/node": "^22.19.17",
		"@vitest/browser-playwright": "^4.1.5",
		"chokidar-cli": "^3.0.0",
		"globals": "^17.6.0",
		"oxlint": "^1.63.0",
		"playwright": "^1.59.1",
		"prettier": "^3.8.3",
		"prettier-plugin-svelte": "^3.5.1",
		"prettier-plugin-tailwindcss": "^0.7.4",
		"protobufjs-cli": "^2.0.3",
		"svelte": "^5.55.5",
		"svelte-check": "^4.4.8",
		"tailwindcss": "^4.2.4",
		"typescript": "^5.9.3",
		"vite": "^7.3.2",
		"vitest": "^4.1.5",
		"vitest-browser-svelte": "^2.1.1"
	},
	"dependencies": {
		"@sveltejs/adapter-static": "^3.0.10",
		"@types/d3": "^7.4.3",
		"culori": "^4.0.2",
		"d3": "^7.9.0",
		"protobufjs": "^8.0.3"
	}
}
